{
  "name": "patcharan",
  "version": "0.1.2",
  "description": "patch/unpatch JavaScript functions multiple times easily",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "index.js",
    "index.d.ts",
    "package.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],  
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test ./test.js",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run typecheck",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "docs": "serve docs",
    "typecheck": "tsc --declarationDir ./build && diff ./index.d.ts ./build/index.d.ts && rm -rf ./build",
    "build:types": "tsc"
  },
  "keywords": [
    "monkeypatch",
    "swizzle",
    "wrapping",
    "shim"
  ],
  "author": "David Luna <luna.bistuer@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david-luna/patcharan.git"
  },
  "bugs": {
    "url": "https://github.com/david-luna/patcharan/issues"
  },
  "homepage": "https://david-luna.github.io/patcharan/",
  "devDependencies": {
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "typescript": "^5.9.3"
  }
}
